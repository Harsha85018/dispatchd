{
  "uid": "dispatchd",
  "title": "dispatchd",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Job throughput",
      "description": "Attempts reported by workers per second, by outcome.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dispatchd_jobs_completed_total[1m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(dispatchd_jobs_submitted_total[1m]))",
          "legendFormat": "submitted"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Jobs per status. max() not sum(): every replica samples the same database, so summing would multiply by the replica count.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max(dispatchd_jobs) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Lease latency",
      "description": "Server-side time to hand out a lease.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(dispatchd_http_request_duration_seconds_bucket{path=\"/lease\"}[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(dispatchd_http_request_duration_seconds_bucket{path=\"/lease\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(dispatchd_http_request_duration_seconds_bucket{path=\"/lease\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Lease poll efficiency",
      "description": "200 means work was handed out; 204 means the worker polled an empty queue. A high 204 rate is wasted round trips.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dispatchd_http_requests_total{path=\"/lease\",status=\"200\"}[1m]))",
          "legendFormat": "work handed out"
        },
        {
          "refId": "B",
          "expr": "sum(rate(dispatchd_http_requests_total{path=\"/lease\",status=\"204\"}[1m]))",
          "legendFormat": "empty poll"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Lease failures",
      "description": "Reaped leases mean workers died or overran. Lost leases mean a stale result was rejected. Both should be zero when healthy.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dispatchd_leases_reaped_total[1m]))",
          "legendFormat": "reaped"
        },
        {
          "refId": "B",
          "expr": "sum(rate(dispatchd_leases_lost_total[1m]))",
          "legendFormat": "lost (stale result rejected)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(dispatchd_leases_renewed_total[1m]))",
          "legendFormat": "renewed"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP traffic by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dispatchd_http_requests_total[1m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ]
    }
  ]
}